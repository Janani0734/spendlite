# --- PostgreSQL (used by docker-compose) ---
POSTGRES_USER=spendlite
POSTGRES_PASSWORD=change_me_dev_password
POSTGRES_DB=spendlite
# Host port. 5433 avoids clashing with any local Postgres on 5432.
POSTGRES_PORT=5433

# --- Backend ---
# Password here must match POSTGRES_PASSWORD. Avoid special characters in it.
DATABASE_URL=postgresql://spendlite:change_me_dev_password@localhost:5433/spendlite?schema=public
JWT_SECRET=replace_with_a_random_string_of_at_least_32_characters
JWT_EXPIRES_IN_SECONDS=604800
BCRYPT_ROUNDS=12
# --- AI (optional; any OpenAI-compatible API) ---
# Leave LLM_API_KEY empty to turn AI features off. The rest of the app works without them.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
# Use a model name your provider supports (see its docs).
LLM_MODEL=